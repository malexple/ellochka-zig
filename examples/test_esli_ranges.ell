CLSC
LIST 'Тест ESLI: диапазоны и строки'

X:50
ESLI X == {10,100};8
LIST 'X=50 in [10,100]: ОШИБКА'
GOTO 9
LIST 'X=50 in [10,100] вкл: OK'

X:10
ESLI X == {10,100};14
LIST 'X=10 граница вкл: ОШИБКА'
GOTO 15
LIST 'X=10 граница вкл: OK'

X:10
ESLI X |= }10,100{;20
LIST 'X=10 не искл: ОШИБКА'
GOTO 21
LIST 'X=10 не искл (границу): OK'

X:50
ESLI X |= }10,100{;26
LIST 'X=50 не должен считаться вне: ОШИБКА'
GOTO 27
LIST 'X=50 внутри искл, переход не был: OK'

$0='привет'
$1='привет'
ESLI $0==$1;33
LIST 'Строки равны: ОШИБКА'
GOTO 34
LIST 'Строки равны: OK'

$0='привет'
$1='мир'
ESLI $0|=$1;40
LIST 'Строки не равны: ОШИБКА'
GOTO 41
LIST 'Строки не равны: OK'

LIST 'Тест JULD'
D:1
M:1
Y:2000
J:0
JULD D;M;Y;J
LIST 'JDN 01.01.2000 (2451545): '; J

D:0
M:0
Y:0
JULD D;M;Y;J
LIST 'Обратно: '; D; '.'; M; '.'; Y

LIST 'Готово'
EXIT
