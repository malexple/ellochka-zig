! Тест KEYS/WAIT/SUMA/MINA/MAXA/DATA
CLSC
CSIM 2
LIST 'ТЕСТ KEYS/WAIT/SUMA/MINA/MAXA/DATA'
CSIM 7
LIST ''

! SUMA/MINA/MAXA
SIZE [5]=M
M[1]=7
M[2]=2
M[3]=9
M[4]=2
M[5]=4
SUMA M;S
LIST 'Сумма M: '; S
MINA M;I
LIST 'Индекс минимума (первый): '; I
MAXA M;J
LIST 'Индекс максимума: '; J
LIST ''

! DATA с меткой
SIZE 10
DATA 1;3;@slova
I=1
LIST 'Слово 1: '; $I
I=2
LIST 'Слово 2: '; $I
I=3
LIST 'Слово 3: '; $I
LIST ''

! KEYS - неблокирующая проверка (без ожидания)
LIST 'Проверка KEYS:'
KEYS A
LIST 'Код клавиши (0=нет нажатия): '; A
LIST ''

! WAIT - блокирующее ожидание любой клавиши
LIST 'Нажмите любую клавишу...'
WAIT B
LIST 'Код нажатой клавиши: '; B

CSIM 7
EXIT

@slova
Alpha
Beta
Gamma
