CLSC
LIST 'Тест APRO / NTGR'

! --- APRO: y=2+3x+x^2, ждём P=[2,3,1], K=1, S=0 ---
SIZE [5]=X;Y
X[1]=1
Y[1]=6
X[2]=2
Y[2]=12
X[3]=3
Y[3]=20
X[4]=4
Y[4]=30
X[5]=5
Y[5]=42
SIZE [3]=P
APRO X;Y;P;2;K;S
LIST 'APRO: P1='; P[1]; ' P2='; P[2]; ' P3='; P[3]
LIST '      K='; K; ' S='; S; ' (ждём 2,3,1,K=1,S=0)'

! --- NTGR: интеграл X^2 на [0,3], ждём ~9 ---
$0='X^2'
NTGR $0;0;3;1000;U
LIST 'NTGR: integral X^2 [0,3] = '; U; ' (ждём ~9)'

! --- NTGR: интеграл X на [0,4], ждём 8 ---
$1='X'
NTGR $1;0;4;1000;V
LIST 'NTGR: integral X [0,4] = '; V; ' (ждём 8)'

! --- NTGR: A==B, ждём 0 без ошибок ---
NTGR $0;5;5;10;W
LIST 'NTGR: A==B = '; W; ' (ждём 0)'

LIST 'Готово'
EXIT
