CLSC
LIST 'Тест TRAN'

! --- система: X1^2+X2^2-4=0, X1-X2=0 -> X1=X2=sqrt(2)=1.41421 ---
SIZE [2]=X
$1='X[1]^2+X[2]^2-4'
$2='X[1]-X[2]'
X[1]=1
X[2]=1
T=100
TRAN X;2;0.000001;T;U
LIST 'TRAN: X1='; X[1]; ' X2='; X[2]
LIST '      U='; U; ' T='; T; ' (ждём X1=X2=1.41421, U=0)'

! --- та же система, плохой старт ---
X[1]=-3
X[2]=10
T=100
TRAN X;2;0.000001;T;U
LIST 'TRAN (плохой старт): X1='; X[1]; ' X2='; X[2]
LIST '            U='; U; ' (ждём U=0, тот же ответ)'

LIST 'Готово'
EXIT
