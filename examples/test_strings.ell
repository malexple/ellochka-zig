! Тест строк: $A-Z, конкат, код символа
CLSC
CSIM 2
LIST 'ТЕСТ СТРОКОВЫХ ОПЕРАЦИЙ'
CSIM 7
LIST ''

! Выделяем строковый массив на 10 элементов
SIZE 10

! Косвенная адресация: $I -> static_strings[I]
I=1
$I='Privet'
LIST 'I=1, $I='; $I

I=2
$I='Mir'
LIST 'I=2, $I='; $I

! Конкатенация через +
J=1
K=2
L=3
$L=$J+' '+$K
I=3
LIST '$L (I=3) = '; $I

! Код символа: A:$?[индекс]
I=1
A:$I[1]
LIST 'Код 1-го символа $I: '; A

! Запись кода символа: $?[индекс]=выражение
$I[1]=90
LIST 'После записи 90: '; $I

! Короткая форма A:константа
C:42
LIST 'C:42 -> C='; C

! Вычисление выражения из строки: A#$текст
I=4
$I='2+3*4'
B#$I
LIST 'Результат "'; $I; '" = '; B

CSIM 7
EXIT