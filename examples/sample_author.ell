!==========================================================================
!================== sample.ela (примеры применения операторов) ============
!==========================================================================
!  Приведенные здесь примеры не всегда являются оптимальными и не всегда
!  имеют практический смысл, назначение этого файла - просто показать, как
!  использовать основные операторы и конструкции языка.
!--------------------------------------------------------------------------
graf
C=@+2
goto @raduga
C:0
csim C
rama 0;0;639;479
pain 320;240;C
stro 14
$0='ОБУЧЕНИЕ ЯЗЫКУ `ELLOCHKA`'
dlin $0;L
stlb 39-L/2
csim 15
list $0\
I:1
@cikl0
incr I
     J=(I-1)-&int((I-1)/7)*7+1
     N:0
     incr N
          cvet C; R[J]*N; G[J]*N; B[J]*N
          slep 10
          keys A
          esli A |= 0; @begin
     esli N << 63; -5\
     decr N
          cvet C; R[J]*N; G[J]*N; B[J]*N
          slep 10
          keys A
          esli A |= 0; @begin
     esli N >> 0; -5\
goto @cikl0
!==========================================================================
!================== вывод меню разделов ===================================
!==========================================================================
@begin
size 4
text
clsc
csim 15
stro 7
data 1;4;@datmenu
menu 4;4;10;33;P
esli P == 1; @grafika
esli P == 2; @files
esli P == 3; @matem
esli P == 4; @raznoe
text
csim 7
cfon 0
clsc
exit
!==========================================================================
!================== графические операторы =================================
!==========================================================================
@grafika
graf
orup
C=@+2
goto @raduga
csim 0
pixl 320;240
I:0
@cikl1
incr I
     csim I*4-&int((I*4+1)/9)*9+2
     move 0; I*2-1
     csim I*4-&int((I*4+2)/9)*9+3
     move 1-I*2; 0
     csim I*4-&int((I*4+3)/9)*9+4
     move 0; -I*2
     csim I*4-&int((I*4+4)/9)*9+5
     move I*2; 0
esli I << 236; @cikl1
grds
I:0
@cikl4
incr I
     J=(I-1)-&int((I-1)/8)*8+1
     cvet (I-1)-&int((I-1)/9)*9+1; R[J]*63; G[J]*63; B[J]*63
     slep &abs(100*&sin(I))+1
     keys A
esli A == 0; @cikl4
clsc
cvet
ordn
I:0
@cikl3
     I=1-I
     A=&ran#
     esli I == 0; +2\
          A=1/A
     csim &int(&ran#*14)+1
     krug &ran#*100+20; &ran#*100+20; &ran#*20; A
     keys A
esli A == 0; @cikl3
csim 15
rama 20;20;121;121
size [16]=C
memc 1C
stro 1
stlb 40
list 'ЖДИТЕ!'
I:20
incr I
     J:20
     incr J
          rdot I;J;C
          C[C+1]=C[C+1]+1
     esli J << 120; -3\
esli I << 120; -6\
stlb 40
list 'количества точек данного цвета'\
I:-1
incr I
     stlb 60
     list I;' - ';C[I+1]\
esli I << 14; -3\
suma C;S
stlb 40
list 'Всего точек:';S\
wait
goto @begin
!==========================================================================
!================== пример файловых операций ==============================
!==========================================================================
@files
M=60
size M+M/3
text
clsc
csim 7
$0=''
vvod 'введите путь и маску для вывода списка файлов: ';$0\
esli $0=='' @begin
$1=$0
path $1
esli $1=='' +7\
file $0;N
esli N |= 0; +4\
     list 'файлов нет, нажмите любую клавишу для нового ввода'\
     wait
     goto -10\
esli N >> 0; +4\
     list 'нет доступа, нажмите любую клавишу для нового ввода'\
     wait
     goto -14\
clsc
F:1
sort $;N;F
cfon 7
csim 0
stlb 1
list 'маска поиска: `';$0;'`'\
list 'вывод на экран и в файл `files.tmp` (с накоплением данных)'\
cfon 0
csim 14
I:0
@cikl2
incr I
     $2=$I
     $3=$1+$2
     lenf $3;F
     dlin $2;L
     $3=$2+%chr(12-L,32)+F
     dlin $3;L
     $3=$3+%chr(21-L,255)
     K=M+&int((I-1)/3)+1
     $K=$K+$3
esli I << N; @cikl2
I=M
incr I
     $1=$I
     list $1\
esli I << M+N/3; -3\
list ''
type 'files.tmp';$$;1;0
wait
goto @begin
!==========================================================================
!============ пример математических расчетов и вывод графика ==============
!==========================================================================
@matem
!------------- аппроксимация функцией реакции -----------------------------
clsc
vvod 'введите число точек (от 100 до 500):';M\
esli M |= {100,500} -1\
size [M]=X;Y
A:10
B:6
C:2
X:1
X[]=1+.011*(?-1)
Y[]=A*X[]^B*&exp(-C*X[])+&ran#
reak X;Y;A;B;C;R;F
!------------------ ввод имени файлов -------------------------------------
vvod 'введите имя выходного файла (без расширения):';$0\
find $0;'.';1;N
esli N >> 0; -2\
$1=$0+'.txt'
$2=$0+'.dat'
$3=$0+'.bmp'
!------------------ поиск минимального и максимального значений -----------
mina Y;V
maxa Y;W
V=Y[V]
W=Y[W]
D=400/(W-V)
!------------------ построение графика ------------------------------------
graf
cvet
orup
csim 15
line 10;60;600;60
line 10;60;10;470
csim 11
I:0
incr I
     pixl I+10; (Y[I]-V)*D+61
esli I << M; -2\
csim 15
stro 28
stlb 1
list 'A=';A;';  B=';B;';  C=';C\
list 'корреляция:';R;' отклонение:';F
!------------------ сохранение текстового файла ---------------------------
udal $1
I:0
$4=%chr(1,9)
type $1;'   X   ';$4;'   Y   '
incr I
     type $1;X[I];$4;Y[I]
esli I << M; -2\
!------------------ сохранение двоичного файла ----------------------------
udal $2
putf $2;1X;4;0;8
putf $2;1Y;4;4;8
!------------------ сохранение BMP-файла ----------------------------------
sbmp $3
!------------------ ожидание клавиши для продолжения ----------------------
stro 30
stlb 2
list 'готово'
wait
goto @begin
!==========================================================================
!============ пример различных действий ===================================
!==========================================================================
@raznoe
clsc
list 'введите жесткий диск для очистки свободного места: '
vvod $9\
esli $9=='' @begin
dlin $9;L
esli L >> 1; -4\
D:$9[1]
esli D << 91; +2\
     D=D-32
esli D |= {67,90} -8\
D=D-64
free D;L
L=L/1024
$9=%chr(1024,0)
list 'заполнять случайными строками? (Y/N)'
wait K#
esli K |= 89; +5\
     I:0
     incr I
          $9[I]=&ran#*255
     esli I << 1024; -2\
$8=%chr(1,D+64)+':\tempo.tmp'
list ''\
list 'Потребуется много времени, для прерывания нажмите любую клавишу'\
I:0
incr I
     putf $8;$9;1024;(I-1)*1024
     keys K
     esli K |= 0; +2\
esli I << L; -4\
lenf $8;L
udal $8
list 'Обработано';L;' байт'\
wait
goto @begin
!==========================================================================
@raduga
size [8]=R;G;B
R[]=&sgn(&int((?-1)/4))
G[]=&sgn(&frc(&int((?-1)/2)/2)*2)
B[]=&sgn(&frc((?-1)/2)*2)
J:0
incr J
     cvet J; R[J]*63; G[J]*63; B[J]*63
esli J << 8; -2\
goto C
!==========================================================================
@datmenu
графика
файлы
математика
разное
!==========================================================================
