! ТЕСТ 4: строки $ и % функции
$0='HELLO'
$1='WORLD'
$2=$0+' '+$1
LIST '--- Конкатенация ---'
LIST $2
DLIN $2;L
LIST 'DLIN=';L;'  (ожидание 11)'
A:$0[1]
LIST 'код $0[1]=';A;'  (ожидание 72, H)'
$3=%MID($0,1,3)
LIST '%MID($0,1,3)=';$3;'  (ожидание HEL)'
$4=%CHR(3,65)
LIST '%CHR(3,65)=';$4;'  (ожидание AAA)'
FIND $0;'LL';1;N
LIST 'FIND LL в $0 -> N=';N;'  (ожидание 3)'
$5='ZZ'
$5[1]=65
LIST '$5 после $5[1]=65 ->';$5;'  (ожидание AZ)'
EXIT
