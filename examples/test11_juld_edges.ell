! Целый JDN: DOS добавляет 0.5 к дню
D=0
M=0
Y=0
J=2451604
JULD D;M;Y;J
ESLI D == 29.5; @i01
LIST 'FAIL: J=2451604 -> D=29.5'
GOTO @in01
@i01
ESLI M == 2; @i02
LIST 'FAIL: J=2451604 -> M=2'
GOTO @in01
@i02
ESLI Y == 2000; @i03
LIST 'FAIL: J=2451604 -> Y=2000'
GOTO @in01
@i03
LIST 'OK: J=2451604 -> 29.5.02.2000'
@in01
D=0
M=0
Y=0
J=2488129
JULD D;M;Y;J
ESLI D == 1.5; @i04
LIST 'FAIL: J=2488129 -> D=1.5'
GOTO @in02
@i04
ESLI M == 3; @i05
LIST 'FAIL: J=2488129 -> M=3'
GOTO @in02
@i05
ESLI Y == 2100; @i06
LIST 'FAIL: J=2488129 -> Y=2100'
GOTO @in02
@i06
LIST 'OK: J=2488129 -> 01.5.03.2100'
@in02
EXIT
