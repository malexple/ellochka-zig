! ТЕСТ 11: JULD — границы календаря, строгая DOS-совместимость
! Прямая ветка: дата -> JDN-0.5
! 28.02.2000
D=28
M=2
Y=2000
J=0
JULD D;M;Y;J
ESLI J == 2451602.5; @f01
LIST 'FAIL: 28.02.2000 -> J'
GOTO @n01
@f01
LIST 'OK: 28.02.2000 -> 2451602.5'
@n01
