! Круговое преобразование: 29.02.2000
D=29
M=2
Y=2000
J=0
JULD D;M;Y;J
D=0
M=0
Y=0
JULD D;M;Y;J
ESLI D == 29; @r01
LIST 'FAIL: round-trip 29.02.2000 (D)'
GOTO @rn01
@r01
ESLI M == 2; @r02
LIST 'FAIL: round-trip 29.02.2000 (M)'
GOTO @rn01
@r02
