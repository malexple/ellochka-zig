! ТЕСТ 2: массивы X[] и Y[,]
SIZE [5]=X
X[1]=10
X[2]=20
X[]=?*2
LIST '--- 1D массив X (2 4 6 8 10) ---'
LIST 'X[1]=';X[1];'  X[2]=';X[2];'  X[3]=';X[3]
LIST 'X[4]=';X[4];'  X[5]=';X[5]

SIZE [3,3]=Y
Y[,]=?1*10+?2
LIST '--- 2D массив Y (11 12 13/21 22 23/31 32 33) ---'
LIST 'Y[1,1]=';Y[1,1];'  Y[1,2]=';Y[1,2];'  Y[1,3]=';Y[1,3]
LIST 'Y[2,1]=';Y[2,1];'  Y[2,2]=';Y[2,2];'  Y[2,3]=';Y[2,3]
LIST 'Y[3,1]=';Y[3,1];'  Y[3,2]=';Y[3,2];'  Y[3,3]=';Y[3,3]

LIST '--- Конец теста 2 ---'
EXIT
