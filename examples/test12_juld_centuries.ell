! ДИАГНОСТИКА JULD: вековые годы, 01.03.YYYY
! FWD: дата -> J и diff относительно стандартного JDN-0.5
! REV: целый стандартный JDN -> D,M,Y
! --- 1900 ---
D=1
M=3
Y=1900
J=0
JULD D;M;Y;J
E=J-2415079.5
LIST 'FWD 1900: J=';J;' diff=';E
D=0
M=0
Y=0
J=2415080
JULD D;M;Y;J
LIST 'REV 1900: D=';D;' M=';M;' Y=';Y
