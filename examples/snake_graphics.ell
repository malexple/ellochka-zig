CLSC
W=40
B=28
Z=16

@menu
CLSC
LIST 'ЗМЕЙКА (графика)'
LIST 'Enter - Старт   Esc - Выход'
WAIT K
ESLI K == 13; @startgame
EXIT

@startgame
GRAF
ORDN
CVET 1;0;63;0
CVET 2;63;0;0
CVET 3;40;40;40
CSIM 3
RAMA 0;0;640;448

CLSC
LIST 'Кликните мышью по ЭТОМУ окну консоли,'
LIST 'затем нажмите любую клавишу для старта.'
WAIT K
LIST 'Счёт: 0 Длина: 5'

SIZE [50]=X
SIZE [50]=Y
L=5
D=4
S=0

I=1
@init
X[I]=9
Y[I]=11-I
I=I+1
ESLI I <= L; @init

CSIM 1
I=1
@draw0
RAMA (Y[I]-1)*Z;(X[I]-1)*Z;Y[I]*Z-1;X[I]*Z-1
I=I+1
ESLI I <= L; @draw0

F=&INT(&RAN*B)+1
G=&INT(&RAN*W)+1
CSIM 2
KRUG G*Z-Z/2;F*Z-Z/2;Z/2-2;1

@loop
KEYS K
ESLI K == 293; @dirleft
ESLI K == 294; @dirup
ESLI K == 295; @dirright
ESLI K == 296; @dirdown
GOTO @move

@dirleft
ESLI D == 4; @move
D=3
GOTO @move

@dirup
ESLI D == 2; @move
D=1
GOTO @move

@dirright
ESLI D == 3; @move
D=4
GOTO @move

@dirdown
ESLI D == 1; @move
D=2
GOTO @move

@move
T=X[L]
U=Y[L]

N=X[1]
M=Y[1]
ESLI D == 1; @deltaup
ESLI D == 2; @deltadown
ESLI D == 3; @deltaleft
ESLI D == 4; @deltaright

@deltaup
N=N-1
GOTO @checkbounds
@deltadown
N=N+1
GOTO @checkbounds
@deltaleft
M=M-1
GOTO @checkbounds
@deltaright
M=M+1
GOTO @checkbounds

@checkbounds
ESLI N << 1; @gameover
ESLI N >> B; @gameover
ESLI M << 1; @gameover
ESLI M >> W; @gameover

I=1
@selfcheck
ESLI X[I] == N; @selfmaybe
GOTO @selfnext
@selfmaybe
ESLI Y[I] == M; @gameover
@selfnext
I=I+1
ESLI I <= L; @selfcheck

ESLI N == F; @maybeeat
GOTO @noeat

@maybeeat
ESLI M == G; @doeat
GOTO @noeat

@doeat
CSIM 0
KRUG G*Z-Z/2;F*Z-Z/2;Z/2-2;1
S=S+1
ESLI L >= 50; @printstats
L=L+1

@printstats
LIST 'Счёт: '; S; ' Длина: '; L
GOTO @aftergrow

@noeat
CSIM 0
RAMA (U-1)*Z;(T-1)*Z;U*Z-1;T*Z-1
GOTO @aftergrow

@aftergrow
I=L
@shift
ESLI I <= 1; @sethead
X[I]=X[I-1]
Y[I]=Y[I-1]
I=I-1
GOTO @shift

@sethead
X[1]=N
Y[1]=M

CSIM 1
RAMA (M-1)*Z;(N-1)*Z;M*Z-1;N*Z-1

ESLI N == F; @respcheck
GOTO @loop2

@respcheck
ESLI M == G; @respawn
GOTO @loop2

@respawn
F=&INT(&RAN*B)+1
G=&INT(&RAN*W)+1
CSIM 2
KRUG G*Z-Z/2;F*Z-Z/2;Z/2-2;1

@loop2
SLEP 150
GOTO @loop

@gameover
TEXT
CLSC
LIST 'Игра окончена! Счёт: '; S; ' Длина: '; L
EXIT
