CLSC
LIST 'Тест USER'

! --- модель Y=A1*X^A2, точные данные A=[3,2] ---
SIZE [5]=X;Y
X[1]=1
Y[1]=3
X[2]=2
Y[2]=12
X[3]=3
Y[3]=27
X[4]=4
Y[4]=48
X[5]=5
Y[5]=75
SIZE [2]=A
A[1]=1
A[2]=1
M=2
$0='A[1]*X^A[2]'
E=0.0000001
T=100
USER $0;M;E;T
LIST 'USER: A1='; A[1]; ' A2='; A[2]; ' (ждём 3, 2)'
LIST '      E='; E; ' T='; T; ' (E ждём ~0)'

LIST 'Готово'
EXIT
